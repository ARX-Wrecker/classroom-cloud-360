APP_NAME="Classroom Cloud 360"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-backend.railway.app

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=${PGHOST}
DB_PORT=${PGPORT}
DB_DATABASE=${PGDATABASE}
DB_USERNAME=${PGUSER}
DB_PASSWORD=${PGPASSWORD}

REDIS_HOST=${REDIS_HOST}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_PORT=${REDIS_PORT}

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

SANCTUM_STATEFUL_DOMAINS=tu-frontend.vercel.app,localhost:3001

CORS_ALLOWED_ORIGINS=https://tu-frontend.vercel.app,http://localhost:3001

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=https://tu-cuenta.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true
